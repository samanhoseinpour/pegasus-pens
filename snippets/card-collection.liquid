{% doc %}
  Renders a collection card.

  @param {collection} card_collection - The collection to display. Pass a blank value to render a placeholder card.
  @param {number} columns - The number of columns used to calculate the responsive image size.
  @param {string} [media_aspect_ratio] - The image aspect ratio. Allowed values are `adapt`, `portrait`, and `square`. Defaults to `square`.
  @param {boolean} [extend_height] - Whether the card fills its available container space. Defaults to `false`.
  @param {string} [wrapper_class] - A custom wrapper class. When blank or `none`, the collection-card wrapper and settings are used.
  @param {string} [placeholder_image] - The placeholder SVG name to render when the collection is blank.
  @param {boolean} [pg_scenes] - Whether a collection with no image of its own shows the bundled photo for its handle (see `pegasus-collection-photo`) in place of its first product's photo. Defaults to `false`. Without it, such a collection shows its first product's cut-out (`custom.cutouts`) when it has one.

  @example
  {% render 'card-collection', card_collection: collection, media_aspect_ratio: 'adapt', columns: 3 %}
{% enddoc %}

{%- liquid
  assign pg_photo = ''
  if pg_scenes and card_collection.image == blank
    capture pg_photo
      render 'pegasus-collection-photo', handle: card_collection.handle, class: 'motion-reduce'
    endcapture
    assign pg_photo = pg_photo | strip
  endif
  assign tile_image = card_collection.featured_image
  if pg_photo != blank
    assign tile_image = null
  endif
  assign pg_cutout = false
  if tile_image and card_collection.image == blank
    assign pg_first_cutout = card_collection.products.first.metafields.custom.cutouts.value | first
    if pg_first_cutout
      assign tile_image = pg_first_cutout
      assign pg_cutout = true
    endif
  endif
  assign has_media = false
  if tile_image or pg_photo != blank
    assign has_media = true
  endif

  assign ratio = 1
  if has_media and media_aspect_ratio == 'portrait'
    assign ratio = 0.75
  elsif tile_image and media_aspect_ratio == 'adapt'
    assign ratio = tile_image.aspect_ratio
  elsif pg_photo != blank and media_aspect_ratio == 'adapt'
    assign ratio = 0.75
  endif
  if ratio == 0 or ratio == null
    assign ratio = 1
  endif
  assign card_color_scheme = settings.card_color_scheme
  assign card_style = settings.card_style
  if wrapper_class == null or wrapper_class == 'none'
    assign card_color_scheme = settings.collection_card_color_scheme
    assign card_style = settings.collection_card_style
  endif
-%}

<div class="card-wrapper animate-arrow {% if wrapper_class and wrapper_class != 'none' %}{{ wrapper_class }}{% else %}collection-card-wrapper{% endif %}">
  <div
    class="
      card
      card--{{ card_style }}
      {% if has_media %} card--media{% else %} card--text{% endif %}
      {% if card_style == 'card' %} color-{{ card_color_scheme }} gradient{% endif %}
      {% if extend_height %} card--extend-height{% endif %}
      {% if has_media == false and card_style == 'card' %} ratio{% endif %}
    "
    style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
  >
    <div
      class="card__inner {% if card_style == 'standard' %}color-{{ card_color_scheme }} gradient{% endif %}{% if has_media or card_style == 'standard' %} ratio{% endif %}"
      style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
    >
      {%- if has_media -%}
        <div class="card__media">
          <div class="media media--transparent media--hover-effect">
            {%- if tile_image == null -%}
              {{- pg_photo -}}
            {%- else -%}
            <img
              srcset="
                {%- if tile_image.width >= 165 -%}{{ tile_image | image_url: width: 165 }} 165w,{%- endif -%}
                {%- if tile_image.width >= 330 -%}{{ tile_image | image_url: width: 330 }} 330w,{%- endif -%}
                {%- if tile_image.width >= 535 -%}{{ tile_image | image_url: width: 535 }} 535w,{%- endif -%}
                {%- if tile_image.width >= 750 -%}{{ tile_image | image_url: width: 750 }} 750w,{%- endif -%}
                {%- if tile_image.width >= 1000 -%}{{ tile_image | image_url: width: 1000 }} 1000w,{%- endif -%}
                {%- if tile_image.width >= 1500 -%}{{ tile_image | image_url: width: 1500 }} 1500w,{%- endif -%}
                {%- if tile_image.width >= 3000 -%}{{ tile_image | image_url: width: 3000 }} 3000w,{%- endif -%}
                {{ tile_image | image_url }} {{ tile_image.width }}w
              "
              src="{{ tile_image | image_url: width: 1500 }}"
              sizes="
                (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: columns }}px,
                (min-width: 750px) {% if columns > 1 %}calc((100vw - 10rem) / 2){% else %}calc(100vw - 10rem){% endif %},
                calc(100vw - 3rem)
              "
              alt="{{ card_collection.featured_image.alt | escape }}"
              height="{{ tile_image.height }}"
              width="{{ tile_image.width }}"
              loading="lazy"
              class="motion-reduce{% if pg_cutout %} pg-cutout{% endif %}"
            >
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
      {%- if card_collection == blank -%}
        <div class="card__media">
          {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- else -%}
        <div class="card__content">
          <div class="card__information">
            <h3 class="card__heading">
              <a
                {% if card_collection == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ card_collection.url }}"
                {% endif %}
                class="full-unstyled-link"
              >
                {%- if card_collection.title != blank -%}
                  {{- card_collection.title | escape -}}
                {%- else -%}
                  {{ 'onboarding.collection_title' | t }}
                {%- endif -%}
                {%- if card_collection.description == blank -%}
                  <span class="icon-wrap">
                    {{- 'icon-arrow.svg' | inline_asset_content -}}
                  </span>
                {%- endif %}
              </a>
            </h3>
            {%- if card_collection.description != blank -%}
              <p class="card__caption">
                {{- card_collection.description | strip_html | truncatewords: 12 -}}
                <span class="icon-wrap">
                  {{- 'icon-arrow.svg' | inline_asset_content -}}
                </span>
              </p>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
    {%- if card_collection != blank and card_style == 'card' or has_media -%}
      <div class="card__content">
        <div class="card__information">
          <h3 class="card__heading">
            <a
              {% if card_collection == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ card_collection.url }}"
              {% endif %}
              class="full-unstyled-link"
            >
              {%- if card_collection.title != blank -%}
                {{- card_collection.title | escape -}}
              {%- else -%}
                {{ 'onboarding.collection_title' | t }}
              {%- endif -%}
              {%- if has_media or card_collection.description == blank -%}
                <span class="icon-wrap">
                  {{- 'icon-arrow.svg' | inline_asset_content -}}
                </span>
              {%- endif %}
            </a>
          </h3>
          {%- if has_media == false and card_collection.description != blank -%}
            <p class="card__caption">
              {{- card_collection.description | strip_html | truncatewords: 12 -}}
              <span class="icon-wrap">
                {{- 'icon-arrow.svg' | inline_asset_content -}}
              </span>
            </p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
    {%- if card_collection == blank -%}
      <div class="card__content">
        <div class="card__information">
          <h3 class="card__heading card__heading--placeholder">
            <a role="link" aria-disabled="true" class="full-unstyled-link">
              {{ 'onboarding.collection_title' | t }}
              <span class="icon-wrap">
                {{- 'icon-arrow.svg' | inline_asset_content -}}
              </span>
            </a>
          </h3>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>
