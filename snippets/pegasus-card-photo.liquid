{% doc %}
  A product card's photos and the pieces of its photo scrub (assets/pegasus-card-gallery.js): the `data-pg-frames`
  attribute, the photos themselves, and the line of segments that shows which photo is up. A card holds up to three
  photos when the second-photo option is on, and one otherwise. A photo with a cut-out (the product's
  `custom.cutouts` list: cut-out i stands in for photo i) shows the cut-out instead, with the class `pg-cutout`.
  Kept out of card-product.liquid so that file stays under theme-check's complexity limit.

  @param {string} part - `attr` prints the `data-pg-frames` attribute, `photos` the photos, `line` the segment line.
  @param {object} product_media - The product's media list.
  @param {boolean} [show] - Whether the second-photo option is on for the card.
  @param {object} [cutouts] - The product's cut-outs (`card_product.metafields.custom.cutouts.value`).
  @param {boolean} [lazy_load] - Whether the first photo is lazy-loaded. Defaults to `true`; the others always are.

  @example
  <div class="card__media" {% render 'pegasus-card-photo', part: 'attr', show: show_secondary_image, product_media: card_product.media %}>
{% enddoc %}
{%- liquid
  assign frames = 1
  if show
    assign frames = product_media.size | at_most: 3 | at_least: 1
  endif
-%}
{%- if part == 'attr' and frames > 1 -%}
  data-pg-frames="{{ frames }}"
{%- elsif part == 'photos' -%}
  {%- assign last = frames | minus: 1 -%}
  {%- for i in (0..last) -%}
    {%- liquid
      assign photo = product_media[i]
      assign picture = photo
      assign cutout = false
      comment
        A list metafield can be looped over but not indexed, so the cut-out for photo i is picked with offset.
      endcomment
      for item in cutouts offset: i limit: 1
        assign picture = item
        assign cutout = true
      endfor
    -%}
    {% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
    <img
      srcset="
        {%- if picture.width >= 165 -%}{{ picture | image_url: width: 165 }} 165w,{%- endif -%}
        {%- if picture.width >= 360 -%}{{ picture | image_url: width: 360 }} 360w,{%- endif -%}
        {%- if picture.width >= 533 -%}{{ picture | image_url: width: 533 }} 533w,{%- endif -%}
        {%- if picture.width >= 720 -%}{{ picture | image_url: width: 720 }} 720w,{%- endif -%}
        {%- if picture.width >= 940 -%}{{ picture | image_url: width: 940 }} 940w,{%- endif -%}
        {%- if picture.width >= 1066 -%}{{ picture | image_url: width: 1066 }} 1066w,{%- endif -%}
        {{ picture | image_url }} {{ picture.width }}w
      "
      src="{{ picture | image_url: width: 533 }}"
      sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
      alt="{% if forloop.first %}{{ photo.alt | escape }}{% endif %}"
      class="motion-reduce{% if cutout %} pg-cutout{% endif %}"
      data-pg-frame="{{ i }}"
      {% unless forloop.first and lazy_load == false %}
        loading="lazy"
      {% endunless %}
      width="{{ picture.width }}"
      height="{{ picture.height }}"
    >
    {% comment %}theme-check-enable ImgLazyLoading{% endcomment %}
  {%- endfor -%}
{%- elsif part == 'line' and frames > 1 -%}
  <span class="pg-card-seg" aria-hidden="true">
    {%- for i in (1..frames) -%}<i></i>{%- endfor -%}
  </span>
{%- endif -%}
