{% doc %}
  The pieces of a product card's photo scrub (assets/pegasus-card-gallery.js) that depend on how many photos the card
  holds: the `data-pg-frames` attribute, the third photo, and the line of segments that shows which photo is up.
  A card holds up to three photos when the second-photo option is on, and one otherwise. Kept out of
  card-product.liquid so that file stays under theme-check's complexity limit.

  @param {string} part - `attr` prints the `data-pg-frames` attribute, `photo` the third photo, `line` the segment line.
  @param {boolean} [show] - Whether the second-photo option is on for the card.
  @param {object} [product_media] - The product's media list. Required with `show`.

  @example
  <div class="card__media" {% render 'pegasus-card-photo', part: 'attr', show: show_secondary_image, product_media: card_product.media %}>
{% enddoc %}
{%- liquid
  assign frames = 1
  if show
    assign frames = product_media.size | at_most: 3 | at_least: 1
  endif
-%}
{%- if part == 'attr' and frames > 1 -%}
  data-pg-frames="{{ frames }}"
{%- elsif part == 'photo' and frames > 2 -%}
  {%- assign third = product_media[2] -%}
  <img
    srcset="
      {%- if third.width >= 165 -%}{{ third | image_url: width: 165 }} 165w,{%- endif -%}
      {%- if third.width >= 360 -%}{{ third | image_url: width: 360 }} 360w,{%- endif -%}
      {%- if third.width >= 533 -%}{{ third | image_url: width: 533 }} 533w,{%- endif -%}
      {%- if third.width >= 720 -%}{{ third | image_url: width: 720 }} 720w,{%- endif -%}
      {%- if third.width >= 940 -%}{{ third | image_url: width: 940 }} 940w,{%- endif -%}
      {%- if third.width >= 1066 -%}{{ third | image_url: width: 1066 }} 1066w,{%- endif -%}
      {{ third | image_url }} {{ third.width }}w
    "
    src="{{ third | image_url: width: 533 }}"
    sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
    alt=""
    class="motion-reduce"
    data-pg-frame="2"
    loading="lazy"
    width="{{ third.width }}"
    height="{{ third.height }}"
  >
{%- elsif part == 'line' and frames > 1 -%}
  <span class="pg-card-seg" aria-hidden="true">
    {%- for i in (1..frames) -%}<i></i>{%- endfor -%}
  </span>
{%- endif -%}
