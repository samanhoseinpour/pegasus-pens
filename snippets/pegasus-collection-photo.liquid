{% doc %}
  Renders the bundled lifestyle photo that belongs to a collection, so every collection has a face before the merchant
  uploads an image. Each scene shows a pen from that collection: `stone` the cross-grain oak pen (hardwood), `leather`
  the six hardwoods pen (segmented wood), `desk` the Canadian leather pen, `skyline` the date seed pen; `gifts` takes
  the plum wood and Khatam pen (`burl`). Renders nothing for any other handle, so those fall back to their first pen's
  photo.

  @param {string} handle - The collection handle: `hardwood`, `segmented-wood`, `leather`, `date-seed` or `gifts`.
  @param {string} [class] - Extra CSS classes for the image.
  @param {string} [loading] - `lazy` (default) or `eager`.

  @example
  {% render 'pegasus-collection-photo', handle: collection.handle, class: 'motion-reduce' %}
{% enddoc %}
{%- liquid
  assign scene = null
  case handle
    when 'hardwood'
      assign scene = 'stone'
    when 'segmented-wood'
      assign scene = 'leather'
    when 'leather'
      assign scene = 'desk'
    when 'date-seed'
      assign scene = 'skyline'
    when 'gifts'
      assign scene = 'burl'
  endcase
-%}
{%- if scene -%}
  {% render 'pegasus-scene', name: scene, class: class, loading: loading %}
{%- endif -%}
