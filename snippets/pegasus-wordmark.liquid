{% doc %}
  Renders the Pegasus wordmark: the Great Square constellation mark followed by the shop name.
  The first word is set upright and the remaining words in italic.

  @param {string} [class] - Extra CSS classes for the wrapper.
  @param {boolean} [text_only] - Whether to omit the constellation mark. Defaults to `false`.

  @example
  {% render 'pegasus-wordmark' %}
  {% render 'pegasus-wordmark', text_only: true, class: 'footer__wordmark-text' %}
{% enddoc %}
{%- liquid
  assign name_words = shop.name | split: ' '
  assign first_word = name_words | first
  assign other_words = name_words | slice: 1, 8 | join: ' '
-%}
<span class="pg-wordmark{% if class != blank %} {{ class }}{% endif %}">
  {%- unless text_only -%}
    <svg
      class="pg-wordmark__mark"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 28 28"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M6 6.5 21 4.5 22.5 19.5 8 21.5Z" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/>
      <path d="m21 4.5 5.5 4.5M8 21.5 2.5 25" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
      <circle cx="6" cy="6.5" r="1.8" fill="currentColor"/>
      <circle cx="21" cy="4.5" r="1.8" fill="currentColor"/>
      <circle cx="22.5" cy="19.5" r="1.8" fill="currentColor"/>
      <circle cx="8" cy="21.5" r="1.8" fill="currentColor"/>
      <circle cx="26.5" cy="9" r="1.1" fill="currentColor"/>
      <circle cx="2.5" cy="25" r="1.1" fill="currentColor"/>
    </svg>
  {%- endunless -%}
  <span class="pg-wordmark__name">{{ first_word }}{% if other_words != blank %} <i>{{ other_words }}</i>{% endif %}</span>
</span>
