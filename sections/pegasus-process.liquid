{{ 'pegasus-process.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pegasus-process.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="pg-proc color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width pg-proc__grid">
    <div class="pg-proc__intro">
      {%- if section.settings.heading != blank -%}
        <h2 class="pg-proc__heading" data-pg-rise>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="pg-proc__lead">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
    <pg-process class="pg-proc__track">
      <span class="pg-proc__rail" aria-hidden="true">
        <span class="pg-proc__ink"></span>
        <svg class="pg-proc__pen" viewBox="0 0 14 48" width="14" height="48" focusable="false">
          <rect class="pg-proc__pen-body" x="2" y="0.6" width="10" height="26" rx="2.4" />
          <path class="pg-proc__pen-line" d="M2 21H12M10 4V13" />
          <path class="pg-proc__pen-tip" d="M2.4 27.2H11.6L8.2 43H5.8Z" />
          <circle class="pg-proc__pen-tip" cx="7" cy="44.4" r="1.5" />
        </svg>
      </span>
      <ol class="pg-proc__steps" role="list">
        {%- for block in section.blocks -%}
          <li class="pg-proc__step" {{ block.shopify_attributes }}>
            <span class="pg-proc__node" aria-hidden="true">{{ forloop.index }}</span>
            <div class="pg-proc__body">
              <h3 class="pg-proc__title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}
                <p class="pg-proc__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
              {%- if block.settings.image != blank -%}
                <div class="pg-proc__media" data-pg-wipe>
                  {{
                    block.settings.image
                    | image_url: width: 1000
                    | image_tag:
                      class: 'pg-proc__img',
                      loading: 'lazy',
                      widths: '500, 750, 1000',
                      sizes: '(min-width: 990px) 40vw, 80vw'
                  }}
                </div>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </pg-process>
  </div>
</div>

{% schema %}
{
  "name": "Pegasus process",
  "tag": "section",
  "class": "pg-proc-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Five stops between the blank and the box."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "What happens to a pen before it reaches you."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "info": "The line and the rings use the scheme's button color, which is gold on the espresso scheme.",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 128
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Choose the blank"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Every pen starts as one block of burl wood, hardwood, laminated wood or resin."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo",
          "info": "Optional. A workshop photo for this step."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pegasus process",
      "blocks": [
        { "type": "step" },
        {
          "type": "step",
          "settings": {
            "title": "Turn it on the lathe",
            "text": "The barrel is shaped from that single piece on the lathe."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Polish by hand",
            "text": "Every barrel is finished by hand: burl is sealed to a deep gloss, hardwood is oiled and resin is polished."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Fit and test",
            "text": "Gold-plated hardware, the twist mechanism and a refillable cartridge go in. We write with every pen before it leaves the bench."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Engrave and box",
            "text": "Engraved on request, then boxed. Add initials or a short line to any pen, and gift wrap and a card with your own words if it is a gift."
          }
        }
      ]
    }
  ]
}
{% endschema %}
