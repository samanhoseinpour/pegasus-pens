{{ 'pegasus-marquee.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  class="pg-marquee color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
  style="--pg-marquee-duration: {{ section.settings.speed }}s;"
>
  {%- capture spoken -%}
    {%- for block in section.blocks -%}{{ block.settings.text | escape }}{% unless forloop.last %}, {% endunless %}{%- endfor -%}
  {%- endcapture -%}
  <p class="visually-hidden">{{ spoken }}</p>

  <div class="pg-marquee__viewport" aria-hidden="true">
    <div class="pg-marquee__track">
      {%- for copy in (1..2) -%}
        <ul class="pg-marquee__list">
          {%- for block in section.blocks -%}
            <li class="pg-marquee__item" {% if copy == 1 %}{{ block.shopify_attributes }}{% endif %}>{{ block.settings.text | escape }}</li>
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pegasus marquee",
  "tag": "section",
  "class": "pg-marquee-section",
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "s",
      "label": "Seconds per loop",
      "info": "Higher is slower. Stops for visitors who prefer reduced motion.",
      "default": 60
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Medium"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pegasus marquee",
      "blocks": [
        { "type": "item", "settings": { "text": "Extra fine" } },
        { "type": "item", "settings": { "text": "Fine" } },
        { "type": "item", "settings": { "text": "Medium" } },
        { "type": "item", "settings": { "text": "Broad" } },
        { "type": "item", "settings": { "text": "Stub" } },
        { "type": "item", "settings": { "text": "Italic" } }
      ]
    }
  ]
}
{% endschema %}
