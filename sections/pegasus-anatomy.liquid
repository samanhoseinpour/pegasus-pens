{{ 'pegasus-anatomy.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="pg-anat color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="pg-anat__heading h1">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="pg-anat__stage">
      <figure class="pg-anat__figure">
        {%- comment -%}
          A twist pen drawn in line on a 240 x 720 grid, axis at x = 120. Body lines are the text color, hardware (the
          top ring, band, tip and clip) is the scheme's button color (gold on espresso). Each line is drawn by scroll
          between two points of the stage's scroll range, set by --a and --b.
        {%- endcomment -%}
        <svg
          class="pg-anat__svg"
          viewBox="0 0 240 720"
          role="img"
          aria-labelledby="PgAnatTitle-{{ section.id }}"
          focusable="false"
        >
          <title id="PgAnatTitle-{{ section.id }}">{{ section.settings.drawing_label | escape }}</title>
          <path class="pg-anat__axis" d="M120 4 V716" />

          <path class="pg-anat__body pg-anat__draw" style="--a: 6%; --b: 18%" pathLength="1" d="M103 96 V36 A17 17 0 0 1 137 36 V96" />
          <path class="pg-anat__body pg-anat__draw" style="--a: 12%; --b: 20%" pathLength="1" d="M103 62 H137 M103 70 H137" />
          <path class="pg-anat__metal pg-anat__draw" style="--a: 10%; --b: 20%" pathLength="1" d="M101 96 H139 V106 H101 Z" />

          <path class="pg-anat__body pg-anat__draw" style="--a: 14%; --b: 38%" pathLength="1" d="M101 106 C100.2 110.8 97.8 125.2 96 135 C94.2 144.8 91.5 154.2 90 165 C88.5 175.8 87.3 188.3 87 200 C86.8 211.7 87.4 223.7 88.5 235 C89.6 246.3 91.8 257.2 93.5 268 C95.2 278.8 97.5 289.7 98.5 300 C99.5 310.3 100.1 319.2 99.5 330 C98.9 340.8 96.8 352.5 95 365 C93.2 377.5 90 392.5 88.5 405 C87 417.5 86.1 428.3 86 440 C85.9 451.7 87 464.2 88 475 C89 485.8 90.9 497.5 92 505 C93.1 512.5 94.1 517.5 94.5 520" />
          <path class="pg-anat__body pg-anat__draw" style="--a: 14%; --b: 38%" pathLength="1" d="M139 106 C139.8 110.8 142.2 125.2 144 135 C145.8 144.8 148.5 154.2 150 165 C151.5 175.8 152.8 188.3 153 200 C153.3 211.7 152.6 223.7 151.5 235 C150.4 246.3 148.2 257.2 146.5 268 C144.8 278.8 142.5 289.7 141.5 300 C140.5 310.3 139.9 319.2 140.5 330 C141.1 340.8 143.2 352.5 145 365 C146.8 377.5 150 392.5 151.5 405 C153 417.5 153.9 428.3 154 440 C154.1 451.7 153 464.2 152 475 C151 485.8 149.1 497.5 148 505 C146.9 512.5 145.9 517.5 145.5 520" />

          <path class="pg-anat__metal pg-anat__draw" style="--a: 30%; --b: 40%" pathLength="1" d="M94 520 H146 V534 H94 Z" />
          <path class="pg-anat__body pg-anat__draw" style="--a: 34%; --b: 46%" pathLength="1" d="M96 534 C96.6 538 98.3 548.7 99.5 558 C100.7 567.3 101.8 578.7 103 590 C104.2 601.3 106.2 620 106.8 626" />
          <path class="pg-anat__body pg-anat__draw" style="--a: 34%; --b: 46%" pathLength="1" d="M144 534 C143.4 538 141.7 548.7 140.5 558 C139.3 567.3 138.2 578.7 137 590 C135.8 601.3 133.8 620 133.2 626" />
          <path class="pg-anat__metal pg-anat__draw" style="--a: 38%; --b: 46%" pathLength="1" d="M105.5 626 H134.5 V634 H105.5 Z" />
          <path class="pg-anat__metal pg-anat__draw" style="--a: 40%; --b: 50%" pathLength="1" d="M107 634 L116.5 690 H123.5 L133 634" />
          <path class="pg-anat__metal pg-anat__draw" style="--a: 44%; --b: 50%" pathLength="1" d="M118.5 690 V699 L120 703 L121.5 699 V690" />

          <path class="pg-anat__metal pg-anat__draw" style="--a: 22%; --b: 38%" pathLength="1" d="M137 40 C150 41 158 50 158.5 68 V290 C158.5 303 154 312 149 317" />
          <path class="pg-anat__metal pg-anat__draw" style="--a: 22%; --b: 38%" pathLength="1" d="M137 52 C158 54 165.5 62 165.5 76 V288 C165.5 303 161 314 156 320" />
          <circle class="pg-anat__metal pg-anat__fade" style="--a: 34%; --b: 40%" cx="153.5" cy="326" r="7" />

          <path class="pg-anat__cart pg-anat__fade" style="--a: 40%; --b: 50%" d="M115 118 V636 L118.5 668 V690 M125 118 V636 L121.5 668 V690 M115 118 H125" />

          <g class="pg-anat__leaders" aria-hidden="true">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'twist' -%}
                  <path class="pg-anat__lead pg-anat__draw" style="--a: 40%; --b: 50%" pathLength="1" d="M108 101 H0" />
                  <circle class="pg-anat__dot pg-anat__fade" style="--a: 40%; --b: 44%" cx="108" cy="101" r="2.6" />
                {%- when 'clip' -%}
                  <path class="pg-anat__lead pg-anat__draw" style="--a: 40%; --b: 50%" pathLength="1" d="M162 170 H240" />
                  <circle class="pg-anat__dot pg-anat__fade" style="--a: 40%; --b: 44%" cx="162" cy="170" r="2.6" />
                {%- when 'barrel' -%}
                  <path class="pg-anat__lead pg-anat__draw" style="--a: 40%; --b: 50%" pathLength="1" d="M98 250 H0" />
                  <circle class="pg-anat__dot pg-anat__fade" style="--a: 40%; --b: 44%" cx="98" cy="250" r="2.6" />
                {%- when 'cartridge' -%}
                  <path class="pg-anat__lead pg-anat__draw" style="--a: 40%; --b: 50%" pathLength="1" d="M115 430 H0" />
                  <circle class="pg-anat__dot pg-anat__fade" style="--a: 40%; --b: 44%" cx="115" cy="430" r="2.6" />
                {%- when 'hardware' -%}
                  <path class="pg-anat__lead pg-anat__draw" style="--a: 40%; --b: 50%" pathLength="1" d="M146 527 H240" />
                  <circle class="pg-anat__dot pg-anat__fade" style="--a: 40%; --b: 44%" cx="146" cy="527" r="2.6" />
              {%- endcase -%}
            {%- endfor -%}
          </g>
        </svg>
      </figure>

      <ul class="pg-anat__parts" role="list">
        {%- for block in section.blocks -%}
          {%- assign label_start = forloop.index0 | times: 1.5 | plus: 40 -%}
          <li
            class="pg-anat__part pg-anat__part--{{ block.type }}"
            style="--a: {{ label_start }}%; --b: {{ label_start | plus: 6 }}%"
            {{ block.shopify_attributes }}
          >
            <strong class="pg-anat__name">{{ block.settings.name | escape }}</strong>
            {%- if block.settings.text != blank -%}
              <span class="pg-anat__text">{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pegasus pen anatomy",
  "tag": "section",
  "class": "pg-anat-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The pen, part by part."
    },
    {
      "type": "text",
      "id": "drawing_label",
      "label": "Name of the drawing, for screen readers",
      "default": "A Pegasus pen drawn in line, with its parts marked"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 112
    }
  ],
  "blocks": [
    {
      "type": "twist",
      "name": "Twist action",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Twist action" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Twist the barrel to bring the tip out, and twist it back to put it away." }
      ]
    },
    {
      "type": "clip",
      "name": "Clip",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Clip" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Holds the pen to a pocket or a page." }
      ]
    },
    {
      "type": "barrel",
      "name": "Turned barrel",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Turned barrel" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Hand-turned from wood or resin." }
      ]
    },
    {
      "type": "cartridge",
      "name": "Refillable cartridge",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Refillable cartridge" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Swap the cartridge and keep the pen." }
      ]
    },
    {
      "type": "hardware",
      "name": "Gold hardware",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Gold hardware" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "The top, clip, bands and tip." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pegasus pen anatomy",
      "blocks": [
        { "type": "twist" },
        { "type": "clip" },
        { "type": "barrel" },
        { "type": "cartridge" },
        { "type": "hardware" }
      ]
    }
  ]
}
{% endschema %}
