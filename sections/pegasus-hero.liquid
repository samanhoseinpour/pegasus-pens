{{ 'pegasus-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_text = section.settings.heading | strip_html | strip
  assign words = heading_text | split: ' '
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif
  assign use_medal = false
  if section.settings.image_style == 'medallion'
    assign use_medal = true
  endif
-%}

<section
  class="pg-hero pg-hero--{{ section.settings.height }} color-{{ section.settings.color_scheme }} gradient{% if has_image and use_medal == false %} pg-hero--has-image{% endif %}{% if use_medal %} pg-hero--medal{% endif %}"
  style="--pg-hero-overlay: {{ section.settings.overlay | divided_by: 100.0 }};"
>
  <div class="pg-hero__media">
    {%- if has_image and use_medal == false -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'pg-hero__image',
          widths: '800, 1200, 1600, 2000, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.image.alt
      }}
    {%- else -%}
      <svg
        class="pg-hero__sky"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 100 100"
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
        focusable="false"
      >
        {%- for i in (1..46) -%}
          {%- liquid
            assign star_x = i | times: 37 | modulo: 100
            assign star_y = i | times: 53 | modulo: 97
            assign star_r = i | modulo: 5 | times: 0.025 | plus: 0.04
            assign twinkles = i | modulo: 7
          -%}
          <circle
            cx="{{ star_x }}"
            cy="{{ star_y }}"
            r="{{ star_r }}"
            {% if twinkles == 0 %}
              class="pg-hero__twinkle"
              style="animation-delay: {{ i | modulo: 5 }}s"
            {% endif %}
          />
        {%- endfor -%}
      </svg>
    {%- endif -%}
  </div>

  {%- if use_medal -%}
    <div class="pg-hero__medal">
      <svg class="pg-hero__rim" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
        <circle class="pg-hero__rim-outer" cx="50" cy="50" r="49" pathLength="1"/>
        <circle class="pg-hero__rim-inner" cx="50" cy="50" r="45.6" pathLength="1"/>
      </svg>
      <div class="pg-hero__photo">
        {%- if has_image -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              class: 'pg-hero__image',
              widths: '600, 900, 1200',
              sizes: '(min-width: 990px) 44vw, 80vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: section.settings.image.alt
          }}
        {%- else -%}
          {%- render 'pegasus-scene', name: section.settings.scene, class: 'pg-hero__image', loading: 'eager' -%}
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.show_constellation -%}
    {%- render 'pegasus-constellation', class: 'pg-hero__map' -%}
  {%- endif -%}

  <div class="pg-hero__inner page-width">
    {%- if heading_text != blank -%}
      <h2 class="pg-hero__heading" aria-label="{{ heading_text | escape }}">
        {%- for word in words -%}
          <span class="pg-w" aria-hidden="true"><span class="pg-wi" style="--i: {{ forloop.index0 }}">{{ word | escape }}</span></span>
          {%- unless forloop.last %} {% endunless -%}
        {%- endfor -%}
      </h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="pg-hero__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank or section.settings.link_label != blank -%}
      <div class="pg-hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a
            class="button"
            {% if section.settings.button_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.button_link }}"
            {% endif %}
          >
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <a
            class="pg-hero__link"
            {% if section.settings.link_url == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.link_url }}"
            {% endif %}
          >
            {{- section.settings.link_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Pegasus hero",
  "tag": "div",
  "class": "pg-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "Optional. Without a photo the hero shows one of the bundled scenes (medallion style) or a night sky (background style)."
    },
    {
      "type": "select",
      "id": "image_style",
      "label": "Photo style",
      "options": [
        { "value": "medallion", "label": "Medallion, framed like the emblem" },
        { "value": "background", "label": "Full-width background" }
      ],
      "default": "medallion"
    },
    {
      "type": "select",
      "id": "scene",
      "label": "Default scene",
      "info": "Shown in the medallion until you choose a photo.",
      "options": [
        { "value": "desk", "label": "Pen on a stand, desk at dusk" },
        { "value": "burl", "label": "Burl wood pen on a leather desk" },
        { "value": "leather", "label": "Pen on a leather notebook" },
        { "value": "stone", "label": "Pen on dark stone" },
        { "value": "skyline", "label": "Marbled pen, city skyline" }
      ],
      "default": "desk"
    },
    {
      "type": "range",
      "id": "overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay (background style)",
      "default": 25
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "tall", "label": "Tall" },
        { "value": "medium", "label": "Medium" },
        { "value": "compact", "label": "Compact" }
      ],
      "default": "tall"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pens made to be written with."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Hand-turned wood and resin pens with gold hardware, made in British Columbia."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop all pens"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Text link label",
      "default": "How they are made"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Text link"
    },
    {
      "type": "checkbox",
      "id": "show_constellation",
      "label": "Draw the Great Square on load",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    }
  ],
  "presets": [
    {
      "name": "Pegasus hero"
    }
  ]
}
{% endschema %}
