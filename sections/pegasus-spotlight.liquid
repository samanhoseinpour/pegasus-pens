{{ 'pegasus-spotlight.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign product = section.settings.product
  assign heading = section.settings.heading
  if heading == blank
    assign heading = product.title
  endif
  assign body = section.settings.text
  if body == blank
    assign body = product.description | strip_html | strip | truncate: 220
  endif
  assign first_option = product.options_with_values | first

  assign pen_cutout = product.metafields.custom.cutouts.value | first
  assign pen_image = pen_cutout | default: product.featured_media
  assign pen_class = ''
  if pen_cutout
    assign pen_class = 'pg-cutout'
  endif
-%}

<div class="pg-spot color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width pg-spot__grid">
    <div class="pg-spot__stage">
      <div class="pg-spot__ring" aria-hidden="true"></div>
      <div class="pg-spot__pen">
        {%- if product.featured_media != blank -%}
          {{
            pen_image
            | image_url: width: 1100
            | image_tag:
              widths: '400, 600, 800, 1100',
              sizes: '(min-width: 990px) 36vw, 70vw',
              loading: 'lazy',
              class: pen_class,
              alt: product.featured_media.alt
          }}
        {%- else -%}
          {%- render 'pegasus-scene', name: 'burl' -%}
        {%- endif -%}
      </div>
    </div>

    <div class="pg-spot__copy">
      {%- if heading != blank -%}
        <h2 class="pg-spot__heading h1" data-pg-rise>{{ heading | escape }}</h2>
      {%- endif -%}
      {%- if body != blank -%}
        <p class="pg-spot__text">{{ body | escape }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 or product.has_only_default_variant == false -%}
        <dl class="pg-spot__specs">
          {%- for block in section.blocks -%}
            <div class="pg-spot__spec" {{ block.shopify_attributes }}>
              <dt>{{ block.settings.label | escape }}</dt>
              <dd>{{ block.settings.value | escape }}</dd>
            </div>
          {%- endfor -%}
          {%- comment -%} The first option (ink) comes from the product itself, so it is always right. {%- endcomment -%}
          {%- if product != blank and product.has_only_default_variant == false and first_option != blank -%}
            <div class="pg-spot__spec">
              <dt>{{ first_option.name | escape }}</dt>
              <dd>
                {%- for value in first_option.values -%}{{ value | escape }}{% unless forloop.last %}, {% endunless %}{%- endfor -%}
                {%- render 'pegasus-swatch-dots', product: product, decorative: true -%}
              </dd>
            </div>
          {%- endif -%}
        </dl>
      {%- endif -%}

      {%- if product != blank -%}
        <div class="pg-spot__buy">
          <div class="pg-spot__price">
            {%- render 'price', product: product, use_variant: false -%}
          </div>
          {%- unless product.available -%}
            <span class="pg-spot__soldout">{{ 'products.product.sold_out' | t }}</span>
          {%- endunless -%}
        </div>
        <div class="pg-spot__actions">
          <a class="button" href="{{ product.url }}">{{ section.settings.button_label | default: 'View pen' | escape }}</a>
          {%- if section.settings.engrave_label != blank -%}
            <a class="pg-spot__link" href="{{ product.url }}?engrave=">{{ section.settings.engrave_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pegasus featured pen",
  "tag": "section",
  "class": "pg-spot-section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Its main photo, price and ink options are shown."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to use the product name."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "info": "Leave empty to use the start of the product description."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View pen"
    },
    {
      "type": "text",
      "id": "engrave_label",
      "label": "Engraving link label",
      "info": "Opens the pen with its engraving field ready. Leave empty to hide the link.",
      "default": "Engrave it"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "info": "Use a light scheme: the pen photo has a white background and is blended into the section color.",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 112
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Detail",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Hardware"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "Gold"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pegasus featured pen",
      "blocks": [
        { "type": "spec", "settings": { "label": "Hardware", "value": "Gold" } },
        { "type": "spec", "settings": { "label": "Mechanism", "value": "Twist action" } },
        { "type": "spec", "settings": { "label": "Refill", "value": "Refillable cartridge" } }
      ]
    }
  ]
}
{% endschema %}
