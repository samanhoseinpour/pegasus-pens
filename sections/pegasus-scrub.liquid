{{ 'pegasus-scrub.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pegasus-scrub.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign words = section.settings.text | strip_html | strip | split: ' '
-%}

<div class="pg-scrub-sec color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if words.size > 0 -%}
      <pg-scrub class="pg-scrub" style="--n: {{ words.size }};">
        {%- comment -%} The words are split here, not in JavaScript, so there is no flash and screen readers read plain text. {%- endcomment -%}
        <p class="pg-scrub__text pg-scrub__text--{{ section.settings.size }}" aria-label="{{ section.settings.text | strip_html | strip | escape }}">
          {%- for word in words -%}
            <span class="pg-scrub__w" style="--i: {{ forloop.index0 }};" aria-hidden="true">{{ word | escape }}</span>
            {%- unless forloop.last %} {% endunless -%}
          {%- endfor -%}
        </p>
      </pg-scrub>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="button button--secondary pg-scrub__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
        {{- section.settings.button_label | escape -}}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Pegasus statement",
  "tag": "section",
  "class": "pg-scrub-section",
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "info": "The words light up one after another as the section scrolls into view.",
      "default": "A good pen makes you want to finish the sentence. We make a short list of pens, each turned from a single blank of wood or resin, and keep refining them until they feel right in the hand. Nothing here is built to be thrown away."
    },
    {
      "type": "select",
      "id": "size",
      "label": "Text size",
      "options": [
        { "value": "large", "label": "Large" },
        { "value": "xl", "label": "Extra large" }
      ],
      "default": "large"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "How we make them"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave empty to open all products."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 120
    }
  ],
  "presets": [
    {
      "name": "Pegasus statement"
    }
  ]
}
{% endschema %}
